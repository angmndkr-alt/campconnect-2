# ---- CampConnect API ----
# Copy to server/.env and adjust.

# PostgreSQL connection string
# Local Homebrew Postgres (default on macOS, OS user is the superuser):
DATABASE_URL=postgresql://localhost:5432/campconnect

# Server
PORT=4000
NODE_ENV=development

# Auth — use a long random string in production (openssl rand -hex 48)
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins. The Vite dev server is
# proxied through /api so CORS is only needed for direct/other-origin calls.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Uploaded file storage (relative to server/ or absolute)
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:4000
